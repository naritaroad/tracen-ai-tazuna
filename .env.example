# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose up -d db) ---
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgres://tracen:CHANGE_ME@127.0.0.1:5432/tracen

# --- API ---
BIND_ADDR=127.0.0.1:8080
# Built web site (npm run build in web/). Leave empty during `npm run dev`.
WEB_DIR=web/dist

# --- Model ---
# These are the starting values; once an admin saves "AI settings and budget" on the management
# site, the stored settings are used instead (no restart needed).
# mock = offline keyword router for development and tests (no key needed).
# Gemini first (docs/decisions.md): MODEL=gemini-3.8-flash with GEMINI_API_KEY.
# Model ids change; check https://ai.google.dev/gemini-api/docs/models before setting one.
MODEL=mock
# Memory curation and summaries (default: MODEL), embeddings (768 dimensions), speech to text (default: MODEL).
MEMORY_MODEL=
EMBED_MODEL=gemini-embedding-2
TRANSCRIBE_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Starting value only; change it later on the management site (AI settings > Conversation).
AGENT_MAX_STEPS=6
# Pause between tool-choice test questions (ms); raise it on free API plans to avoid 429.
EVAL_DELAY_MS=0

# --- Demo data ---
# reset = rebuild the catalog from data/seed/*.csv on every start; if_empty = keep admin edits.
CATALOG_SEED_MODE=reset
SEED_DIR=data/seed
# Demo accounts: trainer, trainer2 (trainer), director (staff), admin (admin). Development only.
SEED_DEMO_ACCOUNTS=true
DEMO_TRAINER_PASSWORD=trainer-demo-2026
DEMO_STAFF_PASSWORD=director-demo-2026
DEMO_ADMIN_PASSWORD=admin-demo-2026

# --- Character player (reserved interface; see docs/avatar-contract.md) ---
CHARACTERS_DIR=assets/characters
# Local folder with .vrm/.vrma runtime files. Leave empty for public deployments.
AVATAR_ASSET_DIR=
# Local game-derived motion library (game_motions.json + vrma/), e.g. _staging/game-motion.
# Research use only (docs/character-assets.md §6): leave empty for anything public.
AVATAR_GAME_MOTION_DIR=
# Local background scene behind the character (scene.json + .glb), e.g. _staging/scene.
# Game-derived (docs/character-assets.md, rights and version-control rules): leave empty for anything public.
AVATAR_SCENE_DIR=

# --- Academy crest ---
# SVG of the official crest (Cygames; in git and the Docker image). Shown in place of the
# horseshoe mark and favicon when the file exists. Leave empty to always use the horseshoe.
BRAND_CREST_FILE=assets/brand/tracen-crest.svg

# --- Cookies ---
COOKIE_SECURE=false
SESSION_DAYS=14
